/* ===== Responsive mobile/tablet layout ===== */
@media (max-width: 768px){
  html,body{background:#fff}
  .site{width:100%;min-height:100vh}

  .header{height:72px;padding:0 22px}
  .brand strong{font-size:18px}
  .brand small{font-size:8px}
  .logo{width:40px;height:40px}

  .hero{
    height:auto;
    min-height:650px;
    background:linear-gradient(180deg,#fff 0%,#fff 47%,#f6ead6 100%);
  }
  .hero-photo{
    top:auto;
    bottom:0;
    right:0;
    width:62%;
    height:52%;
    object-position:70% center;
  }
  .hero:after{
    background:linear-gradient(180deg,#fff 0%,rgba(255,255,255,.97) 42%,rgba(255,255,255,0) 72%);
  }
  .hero-copy{
    position:relative;
    left:auto;
    top:auto;
    padding:42px 25px 0;
    width:min(100%,430px);
  }
  .eyebrow{font-size:10px}
  .hero h1{
    font-size:clamp(34px,9vw,48px);
    line-height:1.02;
    letter-spacing:-1.7px;
    margin:14px 0;
  }
  .hero p{
    width:min(100%,330px);
    font-size:14px;
    line-height:1.45;
  }
  .hero .button{font-size:13px;padding:14px 20px}
  .credit{font-size:10px}
  .hero-phone{
    right:18%;
    bottom:5%;
    width:27%;
    height:31%;
  }
  .hand-lettering{
    right:7%;
    top:auto;
    bottom:33%;
    font-size:15px;
  }

  .features{
    height:auto;
    padding:32px 20px;
    grid-template-columns:repeat(2,1fr);
    gap:1px;
    background:#eee9df;
  }
  .features article{
    background:#fff;
    padding:18px 8px;
    min-height:145px;
  }
  .features article:not(:last-child):after{display:none}
  .feature-icon{width:52px;height:52px}
  .features h2{font-size:13px}
  .features p{font-size:10px}

  .trust{
    height:auto;
    margin:24px 20px;
    padding:18px;
    display:block;
  }
  .trust>div:first-child{
    border-right:0;
    border-bottom:1px solid #ddd8cc;
    padding-bottom:15px;
  }
  .trust h2{font-size:20px}
  .trust p{font-size:10px}
  .secure{padding:15px 0 0}
  .secure h3{font-size:12px}
  .secure p{font-size:9px}

  .paystack{
    height:230px;
    margin:24px 20px;
  }
  .paystack:after{
    background:linear-gradient(90deg,#071323 0%,rgba(7,19,35,.82) 55%,rgba(7,19,35,.15) 100%);
  }
  .paystack-copy{left:18px;top:18px}
  .paystack h2{font-size:24px}
  .paystack p{font-size:11px}
  .dots{left:50%;transform:translateX(-50%)}

  .section-heading{
    height:auto;
    padding:30px 25px 20px;
  }
  .section-heading h2{font-size:23px}
  .section-heading p{font-size:11px}

  .steps{
    height:auto;
    padding:0 20px 25px;
    grid-template-columns:1fr;
    gap:14px;
  }
  .steps article{
    min-height:170px;
    padding:18px;
  }
  .step-icon{
    height:60px;
    text-align:left;
    padding-left:5px;
  }
  .step-icon b{left:48px;right:auto}
  .steps article>span{top:74px}
  .steps h3{font-size:14px;margin-top:24px}
  .steps p{font-size:10px;max-width:320px}

  .industries{
    height:auto;
    margin:5px 20px 24px;
    padding:16px;
  }
  .industries h2{font-size:13px;margin-bottom:14px}
  .industries>div{grid-template-columns:repeat(3,1fr);gap:18px 4px}
  .industries span{font-size:19px}
  .industries small{font-size:8px}

  .growth{
    height:230px;
    margin:0 20px;
  }
  .growth img{
    width:62%;
    height:100%;
    opacity:.82;
  }
  .growth:after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(90deg,#fbf4e5 0%,rgba(251,244,229,.94) 43%,rgba(251,244,229,.05) 100%);
  }
  .growth>div{
    left:22px;
    top:24px;
    width:55%;
  }
  .growth h2{font-size:22px}
  .growth p{font-size:10px;width:100%}

  .footer{
    height:auto;
    min-height:360px;
    padding:28px 22px 24px;
  }
  .footer-grid{
    grid-template-columns:repeat(2,1fr);
    gap:26px 20px;
  }
  .footer-brand{
    grid-column:1/-1;
  }
  .footer-grid h3{font-size:10px}
  .footer-grid a{font-size:9px;line-height:1.7}
  .store{width:110px}
  .contact{
    position:static;
    margin-top:25px;
    padding-top:14px;
    line-height:2;
    font-size:8px;
  }
  .copyright{
    position:static;
    margin-top:14px;
    line-height:1.8;
    font-size:7px;
  }
  .copyright span{
    float:none;
    display:block;
    margin-top:3px;
  }
}

/* Small phones */
@media (max-width:380px){
  .header{height:64px;padding:0 16px}
  .brand strong{font-size:16px}
  .hero{min-height:590px}
  .hero-copy{padding:32px 20px 0}
  .hero h1{font-size:33px}
  .hero p{font-size:12px}
  .hero-phone{right:14%;width:29%}
  .features{padding:22px 12px}
  .trust,.paystack,.growth,.industries{margin-left:14px;margin-right:14px}
  .paystack{height:215px}
  .steps{padding-left:14px;padding-right:14px}
}

/* Tablet */
@media (min-width:769px) and (max-width:1100px){
  .site{width:496px}
}

/* Prevent accidental horizontal scrolling */
img{max-width:100%}
